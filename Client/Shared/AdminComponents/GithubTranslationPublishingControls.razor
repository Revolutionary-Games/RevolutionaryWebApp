@using RevolutionaryWebApp.Shared.Models
@using RevolutionaryWebApp.Shared.Models.Enums
@using RevolutionaryWebApp.Shared
@using RevolutionaryWebApp.Shared.Notifications
@using RevolutionaryWebApp.Client.Services
@using System.Threading
@inject HttpClient Http
@inject NotificationHandler NotificationHandler
@implements INotificationHandler<GithubTokenListUpdated>
@implements IAsyncDisposable

<h4 class="mt-3">GitHub tokens</h4>
<p>Token values are encrypted when stored and cannot be read back after creation.</p>

<StatusMessageShower Message="@message" Type="@messageType" OnClosed="ClearMessage"/>

@if (loading)
{
    <div class="spinner-border text-primary" role="status">
        <span class="visually-hidden">Loading...</span>
    </div>
}
else if (loadFailed)
{
    <p>Unable to display the configured GitHub tokens.</p>
}
else if (tokens.Count == 0)
{
    <p>No GitHub tokens configured.</p>
}
else
{
    <table class="table">
        <thead>
        <tr>
            <th>Type</th>
            <th>Created</th>
            <th></th>
        </tr>
        </thead>
        <tbody>
        @foreach (var token in tokens)
        {
            <tr @key="token.Id">
                <td>@token.Purpose</td>
                <td>@token.CreatedAt.ToLocalTime().ToString("G")</td>
                <td>
                    <Button Small="true" ButtonStyle="outline-danger" Enabled="@(!deleting)"
                            Spinner="@deleting" OnPressed="@(() => DeleteToken(token.Id))">
                        Delete
                    </Button>
                </td>
            </tr>
        }
        </tbody>
    </table>
}

<EditForm Model="newToken" OnValidSubmit="CreateToken" FormName="create-github-token">
    <DataAnnotationsValidator/>
    <div class="row g-2 align-items-end">
        <div class="col-auto">
            <label for="github-token-purpose" class="form-label">Purpose</label>
            <InputSelect id="github-token-purpose" class="form-select" @bind-Value="newToken.Purpose">
                @foreach (var purpose in Enum.GetValues<GithubTokenPurpose>())
                {
                    <option value="@purpose">@purpose</option>
                }
            </InputSelect>
        </div>
        <div class="col">
            <label for="github-token-value" class="form-label">Token</label>
            <InputText id="github-token-value" type="password" class="form-control"
                       autocomplete="new-password" maxlength="500" @bind-Value="newToken.Token"/>
            <ValidationMessage For="() => newToken.Token"/>
        </div>
        <div class="col-auto">
            <Button type="submit" ButtonStyle="primary" Enabled="@(!creating)" Spinner="@creating">
                Create token
            </Button>
        </div>
    </div>
</EditForm>

@code {
    private List<GithubTokenDTO> tokens = [];
    private CreateGithubTokenRequestDTO newToken = new();
    private bool loading = true;
    private bool creating;
    private bool deleting;
    private bool loadFailed;
    private string? message;
    private SiteNoticeType messageType = SiteNoticeType.Danger;

    protected override async Task OnInitializedAsync()
    {
        await NotificationHandler.Register(this);
        await Refresh();
    }

    public Task Handle(GithubTokenListUpdated notification, CancellationToken cancellationToken)
    {
        return InvokeAsync(Refresh);
    }

    public void GetWantedListenedGroups(IUserGroupData currentUserGroups, ISet<string> groups)
    {
        groups.Add(NotificationGroups.GithubTokenListUpdated);
    }

    public async ValueTask DisposeAsync()
    {
        await NotificationHandler.Unregister(this);
    }

    private async Task Refresh()
    {
        try
        {
            tokens = await Http.GetFromJsonAsync<List<GithubTokenDTO>>("api/v1/GithubConfiguration/tokens") ?? [];
            loadFailed = false;
        }
        catch (Exception e)
        {
            loadFailed = true;
            message = $"Could not load GitHub tokens: {e.Message}";
            messageType = SiteNoticeType.Danger;
        }
        finally
        {
            loading = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task CreateToken()
    {
        creating = true;
        message = null;
        await InvokeAsync(StateHasChanged);

        try
        {
            using var response = await Http.PostAsJsonAsync("api/v1/GithubConfiguration/tokens", newToken);
            if (!response.IsSuccessStatusCode)
            {
                message = "Could not create the GitHub token. The selected purpose may already have a token.";
                messageType = SiteNoticeType.Danger;
                return;
            }

            message = $"{newToken.Purpose} token created.";
            messageType = SiteNoticeType.Success;
            newToken = new CreateGithubTokenRequestDTO();
        }
        catch (Exception e)
        {
            message = $"Error while creating the GitHub token: {e.Message}";
            messageType = SiteNoticeType.Danger;
        }
        finally
        {
            creating = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task DeleteToken(long id)
    {
        deleting = true;
        message = null;
        await InvokeAsync(StateHasChanged);
        try
        {
            using var response = await Http.DeleteAsync($"api/v1/GithubConfiguration/tokens/{id}");
            message = response.IsSuccessStatusCode ? "GitHub token deleted." : "Could not delete the GitHub token.";
            messageType = response.IsSuccessStatusCode ? SiteNoticeType.Success : SiteNoticeType.Danger;
        }
        catch (Exception e)
        {
            message = $"Error while deleting the GitHub token: {e.Message}";
            messageType = SiteNoticeType.Danger;
        }
        finally
        {
            deleting = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    private void ClearMessage()
    {
        message = null;
    }

}
