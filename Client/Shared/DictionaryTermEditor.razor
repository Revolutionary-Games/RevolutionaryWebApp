@using RevolutionaryWebApp.Shared.Models
@using RevolutionaryWebApp.Shared.Models.Enums
@using RevolutionaryWebApp.Shared
@inject HttpClient Http
@inject NavigationManager Navigation
@inject Services.CurrentUserInfo UserInfo

<div class="border-bottom py-3">
    <strong>@Term.Word</strong>
    @if (!string.IsNullOrWhiteSpace(Term.Context))
    {
        <small class="text-muted">(@Term.Context)</small>
    }
    @if (!string.IsNullOrWhiteSpace(Term.SourceExplanation))
    {
        <p class="small">@Term.SourceExplanation</p>
    }

    @if (Term.IsLanguageSpecific)
    {
        <span class="badge text-bg-secondary">
            @Term.SourceLanguageCode-specific entry matched by its source word
        </span>
        @if (LanguageCode != "en")
        {
            <label class="form-label mt-2" for="@($"source-word-{controlId}")">
                Source-language word to match
            </label>
            <input id="@($"source-word-{controlId}")" class="form-control" @bind="sourceWord"
                   readonly="@(!CanSaveTerm)"
                   @bind:after="NotifyDirtyState"/>
            <label class="form-label mt-2" for="@($"term-{controlId}")">Term in @LanguageCode</label>
            <input id="@($"term-{controlId}")" class="form-control" @bind="text" readonly="@(!CanSaveTerm)"
                   @bind:after="NotifyDirtyState"/>
            <label class="form-label mt-2" for="@($"explanation-{controlId}")">Explanation in @LanguageCode</label>
            <textarea id="@($"explanation-{controlId}")" class="form-control" @bind="explanation"
                      readonly="@(!CanSaveTerm)"
                      @bind:after="NotifyDirtyState"></textarea>
            <label class="form-label mt-2" for="@($"context-{controlId}")">Context</label>
            <input id="@($"context-{controlId}")" class="form-control" @bind="context" readonly="@(!CanSaveTerm)"
                   @bind:after="NotifyDirtyState"/>
            @if (CanSaveTerm)
            {
                <Button class="mt-2" ButtonStyle="outline-primary" Enabled="@(!saving)" Spinner="@saving"
                        OnPressed="@Save">Save Term
                </Button>
            }
            else if (UserInfo.InfoReady && !UserInfo.LoggedIn)
            {
                <p class="mt-2">
                    <NavLink href="@Navigation.GetLinkToLogin("Log in to translate dictionary terms")">Log in</NavLink>
                    to edit this term.
                </p>
            }

            <StatusMessageShower Message="@message" Type="@messageType" ExtraCSS="mt-2" OnClosed="ClearMessage"/>
        }
        else
        {
            <p>English-specific single language only terms shouldn't exist...</p>
        }
    }
    else if (LanguageCode == "en" && CanManage)
    {
        <label class="form-label mt-2" for="@($"term-{controlId}")">English term</label>
        <input id="@($"term-{controlId}")" class="form-control" @bind="text"
               @bind:after="NotifyDirtyState"/>
        <label class="form-label mt-2" for="@($"context-{controlId}")">Context</label>
        <input id="@($"context-{controlId}")" class="form-control" @bind="context"
               @bind:after="NotifyDirtyState"/>
        <label class="form-label mt-2" for="@($"explanation-{controlId}")">English explanation</label>
        <textarea id="@($"explanation-{controlId}")" class="form-control" @bind="explanation"
                  @bind:after="NotifyDirtyState"></textarea>
        <Button class="mt-2" ButtonStyle="outline-primary" Enabled="@(!saving)" Spinner="@saving"
                OnPressed="@Save">Save Term
        </Button>
        <StatusMessageShower Message="@message" Type="@messageType" ExtraCSS="mt-2" OnClosed="ClearMessage"/>
    }
    else if (LanguageCode != "en")
    {
        <label class="form-label" for="@($"term-{controlId}")">@LanguageCode translation</label>
        <input id="@($"term-{controlId}")" class="form-control" @bind="text" readonly="@(!CanSaveTerm)"
               @bind:after="TranslationTextChanged"/>
        <label class="form-label mt-2" for="@($"explanation-{controlId}")">
            Explanation in @LanguageCode (<strong>if</strong> needed to clarify why this is translated like this)
        </label>
        <textarea id="@($"explanation-{controlId}")" class="form-control" @bind="explanation"
                  readonly="@(!CanSaveTerm)"
                  @bind:after="NotifyDirtyState"></textarea>
        <select class="form-select mt-2" @bind="state" disabled="@(!CanSaveTerm)" @bind:after="NotifyDirtyState">
            <option value="@TranslationState.NeedsTranslation">Needs changes</option>
            <option value="@TranslationState.Translated">Translated</option>
        </select>
        @if (CanSaveTerm)
        {
            <Button class="mt-2" ButtonStyle="outline-primary" Enabled="@(!saving)" Spinner="@saving"
                    OnPressed="@Save">Save Term
            </Button>
        }
        else if (UserInfo.InfoReady && !UserInfo.LoggedIn)
        {
            <p class="mt-2">
                <NavLink href="@Navigation.GetLinkToLogin("Log in to translate dictionary terms")">Log in</NavLink>
                to edit this term.
            </p>
        }

        <StatusMessageShower Message="@message" Type="@messageType" ExtraCSS="mt-2" OnClosed="ClearMessage"/>
    }
</div>

@code {
    private readonly string controlId = Guid.NewGuid().ToString("N");

    private string text = string.Empty;
    private string sourceWord = string.Empty;
    private string context = string.Empty;
    private string? explanation;
    private TranslationState state = TranslationState.NeedsTranslation;
    private string? message;
    private SiteNoticeType messageType = SiteNoticeType.Danger;
    private bool saving;
    private string loadedWord = string.Empty;
    private string loadedContext = string.Empty;
    private string loadedLanguage = string.Empty;
    private string loadedTargetText = string.Empty;
    private string loadedSourceWord = string.Empty;
    private string? loadedTargetExplanation;
    private string loadedEntryContext = string.Empty;
    private TranslationState loadedState;
    private int loadedResetVersion;
    private (string Word, string Context, bool IsDirty)? lastNotifiedDirtyState;

    [Parameter]
    [EditorRequired]
    public DictionaryTermDTO Term { get; set; } = null!;

    [Parameter]
    public string LanguageCode { get; set; } = "en";

    [Parameter]
    public EventCallback<(string Word, string Context, bool IsDirty)> OnDirtyChanged { get; set; }

    [Parameter]
    public EventCallback<(string Word, string Context, bool IsSaving)> OnSavingChanged { get; set; }

    [Parameter]
    public int ResetVersion { get; set; }

    private bool CanManage => UserInfo.AcceptedTranslator &&
        (UserInfo.HasGroup(GroupType.DictionaryManager) || UserInfo.IsAdmin);

    private bool CanEditTarget => UserInfo.AcceptedTranslator && UserInfo.HasAccessLevel(GroupType.User);

    private bool CanSaveTerm => LanguageCode == "en" ? CanManage : CanEditTarget;

    private bool IsDirty => text != loadedTargetText || explanation != loadedTargetExplanation || state != loadedState ||
        (Term.IsLanguageSpecific && sourceWord != loadedSourceWord) ||
        ((Term.IsLanguageSpecific || LanguageCode == "en") && context != loadedEntryContext);

    protected override async Task OnParametersSetAsync()
    {
        if (loadedWord != Term.Word || loadedContext != Term.Context || loadedLanguage != LanguageCode ||
            loadedResetVersion != ResetVersion || !IsDirty)
        {
            loadedWord = Term.Word;
            loadedContext = Term.Context;
            loadedLanguage = LanguageCode;
            loadedResetVersion = ResetVersion;
            LoadTermValues();
        }

        await NotifyDirtyState();
    }

    private void LoadTermValues()
    {
        if (Term.IsLanguageSpecific || LanguageCode == "en")
        {
            text = Term.Word;
            sourceWord = Term.SourceWord ?? string.Empty;
            context = Term.Context;
            explanation = Term.SourceExplanation;
        }
        else
        {
            text = Term.TargetText;
            sourceWord = string.Empty;
            context = Term.Context;
            explanation = Term.TargetExplanation;
        }

        state = Term.State;
        loadedTargetText = text;
        loadedSourceWord = sourceWord;
        loadedTargetExplanation = explanation;
        loadedEntryContext = context;
        loadedState = state;
    }

    private Task TranslationTextChanged()
    {
        state = string.IsNullOrWhiteSpace(text) ? TranslationState.NeedsTranslation : TranslationState.Translated;
        return NotifyDirtyState();
    }

    private Task NotifyDirtyState()
    {
        var dirtyState = (Term.Word, Term.Context, IsDirty);
        if (lastNotifiedDirtyState == dirtyState)
            return Task.CompletedTask;

        // Update before invoking the parent, as its callback can render this editor again.
        lastNotifiedDirtyState = dirtyState;
        return OnDirtyChanged.InvokeAsync(dirtyState);
    }

    private async Task Save()
    {
        if (!CanSaveTerm)
            return;

        saving = true;
        message = null;
        await InvokeAsync(StateHasChanged);
        try
        {
            await OnSavingChanged.InvokeAsync((Term.Word, Term.Context, true));
            using var response = await SendSaveRequest();

            message = response.IsSuccessStatusCode ? "Saved." : "Could not save.";
            messageType = response.IsSuccessStatusCode ? SiteNoticeType.Success : SiteNoticeType.Danger;
            if (response.IsSuccessStatusCode)
            {
                loadedTargetText = text;
                loadedSourceWord = sourceWord;
                loadedTargetExplanation = explanation;
                loadedEntryContext = context;
                loadedState = state;
                await NotifyDirtyState();
            }
            else
            {
                var content = await response.Content.ReadAsStringAsync();
                message = $"Could not save: {content}, {response.StatusCode}";
                messageType = SiteNoticeType.Danger;
            }
        }
        catch (Exception e)
        {
            message = $"Saving failed: {e.Message}";
            messageType = SiteNoticeType.Danger;
        }
        finally
        {
            saving = false;
            await OnSavingChanged.InvokeAsync((Term.Word, Term.Context, false));
        }
    }

    private void ClearMessage()
    {
        message = null;
    }

    private Task<HttpResponseMessage> SendSaveRequest()
    {
        if (LanguageCode == "en")
        {
            return Http.PutAsJsonAsync("api/v1/translationDictionaries/terms/source", new SaveDictionaryTermRequest
            {
                DictionaryId = Term.DictionaryId,
                Word = Term.Word,
                Context = Term.Context,
                NewWord = text,
                NewContext = context,
                Explanation = explanation,
            });
        }

        if (Term.IsLanguageSpecific)
        {
            return Http.PutAsJsonAsync("api/v1/translationDictionaries/terms/language",
                new SaveDictionaryLanguageTermRequest
                {
                    DictionaryId = Term.DictionaryId,
                    LanguageCode = LanguageCode,
                    Word = Term.Word,
                    Context = Term.Context,
                    NewWord = text,
                    NewSourceWord = sourceWord,
                    NewContext = context,
                    Explanation = explanation,
                });
        }

        return Http.PutAsJsonAsync("api/v1/translationDictionaries/terms/translation",
            new SaveDictionaryTranslationRequest
            {
                DictionaryId = Term.DictionaryId,
                Word = Term.Word,
                Context = Term.Context,
                LanguageCode = LanguageCode,
                Text = text,
                Explanation = explanation,
                State = state,
            });
    }

}
