@using RevolutionaryWebApp.Shared.Models
@using RevolutionaryWebApp.Shared.Models.Enums
@inherits EditFormBase<APIKeySettings>

<EditForm EditContext="@EditContext" OnValidSubmit="@Save" class="p-3">
    <DataAnnotationsValidator />
    <label class="me-3">
        <input type="checkbox" @bind="EditedData.ReadOnly" disabled="@ReadOnlyRequired"/> Read only
    </label>
    <div class="my-2">
        <label for="expiry-@ControlIdSuffix">Expiration (local time, optional)</label>
        <input id="expiry-@ControlIdSuffix" type="datetime-local" class="form-control" @bind="expiration"/>
    </div>
    <div class="my-2">
        <label for="network-@ControlIdSuffix">Allowed IP network (CIDR, optional)</label>
        <input id="network-@ControlIdSuffix" class="form-control" placeholder="192.0.2.0/24 or 2001:db8::/32"
               @bind="EditedData.AllowedIPNetwork"/>
    </div>
    <fieldset>
        <legend class="fs-6">Scopes</legend>
        @foreach (var scope in Enum.GetValues<APIKeyScope>())
        {
            <label class="me-3">
                <input type="checkbox" checked="@(AllScopes || EditedData.Scopes.Contains(scope))"
                       disabled="@(AllScopes && scope != APIKeyScope.All)"
                       @onchange="e => ToggleScope(scope, e.Value is true)"/> @scope
            </label>
        }
    </fieldset>
    <ValidationSummary />
    <StatusMessageShower Message="@StatusMessage" Type="@StatusMessageType" />
    <Button class="mt-2 me-1" Enabled="@(!Processing)" Spinner="@Processing" type="submit">@SaveButtonText</Button>
    @ChildContent
</EditForm>

@code {
    private DateTime? expiration;
    private APIKeySettings? previousSettings;

    [Parameter]
    public bool ReadOnlyRequired { get; set; }

    [Parameter]
    public RenderFragment? ChildContent { get; set; }

    private bool AllScopes => EditedData.Scopes.Contains(APIKeyScope.All);

    protected override void OnParametersSet()
    {
        if (ReadOnlyRequired)
            EditedData.ReadOnly = true;

        if (previousSettings == EditedData)
            return;

        previousSettings = EditedData;
        expiration = EditedData.ExpiresAt?.ToLocalTime();
    }

    private void ToggleScope(APIKeyScope scope, bool selected)
    {
        if (AllScopes && scope != APIKeyScope.All)
            return;

        EditedData.Scopes = selected ?
            EditedData.Scopes.Append(scope).Distinct().ToArray() :
            EditedData.Scopes.Where(s => s != scope).ToArray();
    }

    private async Task Save()
    {
        EditedData.ExpiresAt = expiration?.ToUniversalTime();
        await OnValidSubmit.InvokeAsync();
    }

}
