@using RevolutionaryWebApp.Shared
@using RevolutionaryWebApp.Shared.Forms
@using RevolutionaryWebApp.Shared.Models
@inject HttpClient Http

<h4>Password</h4>
<p>
    If you sign in through SSO and have never set a password here, you can only set your first password using an email
    link. Sign out and request the link on the
    <NavLink href="/forgot-password">Forgot password</NavLink>
    page.
</p>
<StatusMessageShower Message="@message" Type="@messageType" OnClosed="ClearMessage"/>

@if (status == null)
{
    <Button OnPressed="OpenForm" Enabled="@(!loading)" Spinner="@loading">Change password</Button>
}
else if (!status.HasPassword)
{
    <p>This account does not have a password yet.</p>
}
else
{
    <EditForm Model="@form" OnValidSubmit="ChangePassword">
        <DataAnnotationsValidator/>
        <fieldset disabled="@saving">
            <div class="mb-3">
                <label for="change-current-password" class="form-label">Current password</label>
                <CustomInputText id="change-current-password" type="password" class="form-control"
                                 @bind-Value="form.CurrentPassword" autocomplete="current-password"
                                 maxlength="@AppInfo.MaxPasswordLength"/>
                <ValidationMessage For="() => form.CurrentPassword"/>
            </div>
            <div class="mb-3">
                <label for="change-new-password" class="form-label">New password</label>
                <CustomInputText id="change-new-password" type="password" class="form-control"
                                 @bind-Value="form.NewPassword" autocomplete="new-password"
                                 maxlength="@AppInfo.MaxPasswordLength"/>
                <div class="form-text">Use @AppInfo.MinPasswordLength to @AppInfo.MaxPasswordLength characters.</div>
                <ValidationMessage For="() => form.NewPassword"/>
            </div>
            <div class="mb-3">
                <label for="change-confirm-password" class="form-label">Confirm new password</label>
                <CustomInputText id="change-confirm-password" type="password" class="form-control"
                                 @bind-Value="confirmPassword" autocomplete="new-password"
                                 maxlength="@AppInfo.MaxPasswordLength"/>
            </div>
            @if (status.TwoFactorEnabled)
            {
                <div class="mb-3">
                    <label for="change-password-code" class="form-label">Authenticator or backup code</label>
                    <CustomInputText id="change-password-code" class="form-control"
                                     @bind-Value="form.TwoFactorCode" autocomplete="one-time-code" maxlength="64"/>
                    <ValidationMessage For="() => form.TwoFactorCode"/>
                </div>
            }
            <Button type="submit" class="me-2" Enabled="@(!saving)" Spinner="@saving">Save password</Button>
            <Button ButtonStyle="secondary" OnPressed="Cancel" Enabled="@(!saving)">Cancel</Button>
        </fieldset>
    </EditForm>
}

@code {
    private const string PasswordChangeEndpoint = "api/v1/password/change";

    private PasswordChangeStatusDTO? status;
    private ChangePasswordRequest form = new();
    private string confirmPassword = string.Empty;
    private bool loading;
    private bool saving;
    private string? message;
    private SiteNoticeType messageType = SiteNoticeType.Danger;

    private async Task OpenForm()
    {
        loading = true;
        message = null;
        messageType = SiteNoticeType.Danger;
        await InvokeAsync(StateHasChanged);

        try
        {
            status = await Http.GetFromJsonAsync<PasswordChangeStatusDTO>(PasswordChangeEndpoint);
        }
        catch (Exception e)
        {
            message = $"Could not load password settings: {e.Message}";
        }
        finally
        {
            loading = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task ChangePassword()
    {
        if (saving || status == null)
            return;

        messageType = SiteNoticeType.Danger;

        if (form.NewPassword != confirmPassword)
        {
            message = "The new passwords do not match.";
            return;
        }

        if (status.TwoFactorEnabled && string.IsNullOrWhiteSpace(form.TwoFactorCode))
        {
            message = "Enter an authenticator code or an unused backup code.";
            return;
        }

        saving = true;
        message = null;
        await InvokeAsync(StateHasChanged);

        try
        {
            using var response = await Http.PostAsJsonAsync(PasswordChangeEndpoint, form);
            if (response.IsSuccessStatusCode)
            {
                CloseForm();
                message = "Your password has been changed.";
                messageType = SiteNoticeType.Success;
            }
            else
            {
                message = response.Content.Headers.ContentType?.MediaType == "text/plain" ?
                    await response.Content.ReadAsStringAsync() :
                    $"Could not change your password ({(int)response.StatusCode}).";
            }
        }
        catch (Exception e)
        {
            message = $"Could not change your password: {e.Message}";
        }
        finally
        {
            saving = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    private void Cancel()
    {
        CloseForm();
        ClearMessage();
    }

    private void CloseForm()
    {
        status = null;
        form = new ChangePasswordRequest();
        confirmPassword = string.Empty;
    }

    private void ClearMessage()
    {
        message = null;
    }

}
