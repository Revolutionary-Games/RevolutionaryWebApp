@using System.Threading
@using RevolutionaryWebApp.Client.Services
@using RevolutionaryWebApp.Shared.Models
@inject HttpClient Http
@inject CurrentUserInfo UserInfo
@inject InboxNotificationState InboxState
@implements IDisposable

@if (UserInfo.LoggedIn)
{
    <NavLink class="nav-link d-inline-flex align-items-center" href="notifications" title="Notifications">
        <i class="fa-solid fa-envelope"></i>
        @if (unread > 0)
        {
            <span class="badge bg-danger ms-1" aria-label="@($"{unread} unread notifications")">@unread</span>
        }
    </NavLink>
}

@code {
    private readonly CancellationTokenSource shutdown = new();
    private int unread;
    private int readVersion;

    public void Dispose()
    {
        UserInfo.OnUserInfoChanged -= UserChanged;
        InboxState.OnAllMarkedRead -= AllMarkedRead;

        try
        {
            shutdown.Cancel();
            shutdown.Dispose();
        }
        catch (ObjectDisposedException)
        {
        }
    }

    protected override async Task OnInitializedAsync()
    {
        UserInfo.OnUserInfoChanged += UserChanged;
        InboxState.OnAllMarkedRead += AllMarkedRead;
        await Refresh();
        _ = Poll();
    }

    private async Task Poll()
    {
        try
        {
            using var timer = new PeriodicTimer(TimeSpan.FromMinutes(1));
            while (await timer.WaitForNextTickAsync(shutdown.Token))
                await Refresh();
        }
        catch (OperationCanceledException)
        {
        }
    }

    private async Task Refresh()
    {
        if (!UserInfo.LoggedIn)
            return;

        try
        {
            var version = readVersion;
            var count = (await Http.GetFromJsonAsync<UnreadNotificationCountDTO>("api/v1/userNotifications/" +
                "unreadCount", shutdown.Token))?.Count ?? 0;

            // A request started before marking everything read may still contain the old count.
            if (version != readVersion)
                return;

            unread = count;
            await InvokeAsync(StateHasChanged);
        }
        catch (OperationCanceledException)
        {
        }
        catch (HttpRequestException)
        {
            // Keep the current badge during a temporary connection failure.
        }
        catch (Exception e)
        {
            // Notification polling is non-critical, so we don't want to crash the app if it fails
            Console.WriteLine(e);
        }
    }

    private async void UserChanged(object? sender, UserDTO? newInfo)
    {
        await Refresh();
    }

    private void AllMarkedRead(object? sender, EventArgs args)
    {
        ++readVersion;
        unread = 0;
        _ = InvokeAsync(StateHasChanged);
    }

}
