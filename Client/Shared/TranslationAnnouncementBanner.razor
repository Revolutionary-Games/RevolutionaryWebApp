@using RevolutionaryWebApp.Shared
@using RevolutionaryWebApp.Shared.Models
@using RevolutionaryWebApp.Shared.Models.Enums
@using RevolutionaryWebApp.Shared.Notifications
@using RevolutionaryWebApp.Client.Services
@using System.Threading
@inject HttpClient Http
@inject NotificationHandler NotificationHandler
@implements INotificationHandler<TranslationProjectUpdated>
@implements IAsyncDisposable

@if (closedForMaintenance)
{
    <div class="alert alert-warning" role="alert">
        This project is closed for maintenance. Translations are temporarily not being accepted.
        <AccessLimited RequiredAccess="GroupType.User">
            <Button ButtonStyle="primary" Enabled="@(!subscribing && !subscribed)" Spinner="@subscribing"
                    OnPressed="Subscribe">@(subscribed ? "Notification requested" : "Notify me when available")</Button>
        </AccessLimited>
        <AccessLimited RequiredAccess="GroupType.Admin">
            <NavLink href="admin/translations">Manage project</NavLink>
        </AccessLimited>
    </div>
}

@if (announcement?.EndsAt > DateTime.UtcNow)
{
    <div class="alert @announcement.Severity.AlertClass()" role="alert">
        <MarkdownRenderer MarkdownText="@announcement.Message"/>
    </div>
}

@if (loadError != null)
{
    <StatusMessageShower Message="@loadError" Type="SiteNoticeType.Warning"/>
}

@code {
    private bool closedForMaintenance;
    private bool subscribing;
    private bool subscribed;
    private long loadedProjectId;

    private TranslationAnnouncementDTO? announcement;
    private string? loadError;
    private Timer? expiryTimer;
    private bool disposed;
    private bool registered;

    [Parameter]
    public long ProjectId { get; set; }

    [Parameter]
    public string Slug { get; set; } = string.Empty;

    public void GetWantedListenedGroups(IUserGroupData currentUserGroups, ISet<string> groups)
    {
        groups.Add(NotificationGroups.TranslationProjectUpdatedPrefix + loadedProjectId);
    }

    public async Task Handle(TranslationProjectUpdated notification, CancellationToken cancellationToken)
    {
        if (notification.ProjectId == loadedProjectId)
            await InvokeAsync(Load);
    }

    public async ValueTask DisposeAsync()
    {
        disposed = true;
        expiryTimer?.Dispose();
        if (registered)
            await NotificationHandler.Unregister(this);
    }

    protected override async Task OnParametersSetAsync()
    {
        await Load();
        if (!registered && !disposed)
        {
            await NotificationHandler.Register(this);
            registered = true;
        }
    }

    private async Task Load()
    {
        loadError = null;
        try
        {
            var project = await Http.GetFromJsonAsync<TranslationProjectDTO>($"api/v1/translations/projects/{Uri.EscapeDataString(Slug)}");
            if (disposed)
                return;

            if (project?.ClosedForMaintenance != true || project.Id != loadedProjectId)
                subscribed = false;

            announcement = project?.Announcement;
            closedForMaintenance = project?.ClosedForMaintenance == true;
            loadedProjectId = project?.Id ?? 0;
            ScheduleExpiry();
        }
        catch (Exception e)
        {
            announcement = null;
            loadError = $"Could not load the translation announcement: {e.Message}";
        }

        await InvokeAsync(StateHasChanged);
    }

    private async Task Subscribe()
    {
        subscribing = true;
        loadError = null;
        await InvokeAsync(StateHasChanged);

        try
        {
            using var response = await Http.PostAsync($"api/v1/TranslationSubscriptions/{loadedProjectId}/reopened", null);
            if (!response.IsSuccessStatusCode)
            {
                loadError = $"Could not subscribe: {await response.Content.ReadAsStringAsync()}";
            }
            else
            {
                subscribed = true;
            }
        }
        catch (Exception e)
        {
            loadError = $"Could not subscribe: {e.Message}";
        }
        finally
        {
            subscribing = false;
        }

        await InvokeAsync(StateHasChanged);
    }

    private void ScheduleExpiry()
    {
        expiryTimer?.Dispose();
        if (announcement?.EndsAt is not { } end || end <= DateTime.UtcNow || disposed)
            return;

        expiryTimer = new Timer(state =>
            {
                if (!disposed)
                {
                    _ = InvokeAsync(() =>
                    {
                        ScheduleExpiry();
                        StateHasChanged();
                    });
                }
            }, null, TimeSpan.FromSeconds(Math.Clamp((end - DateTime.UtcNow).TotalSeconds, 0.01, 86400)),
            Timeout.InfiniteTimeSpan);
    }

}
