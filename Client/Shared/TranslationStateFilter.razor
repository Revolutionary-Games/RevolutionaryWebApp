@using RevolutionaryWebApp.Shared.Models

<select class="form-select" aria-label="@Label" disabled="@Disabled" @bind:get="Value" @bind:set="ValueChanged.InvokeAsync">
    <option value="">Any</option>
    <option value="@TranslationState.NeedsTranslation">Needing changes</option>
    <option value="@TranslationState.Translated">Needing verification</option>
    <option value="@TranslationState.Verified">Verified</option>
</select>

@code {
    [Parameter]
    [EditorRequired]
    public string Label { get; set; } = string.Empty;

    [Parameter]
    public TranslationState? Value { get; set; }

    [Parameter]
    public EventCallback<TranslationState?> ValueChanged { get; set; }

    [Parameter]
    public bool Disabled { get; set; }
}
