@using RevolutionaryWebApp.Shared.Models
@using RevolutionaryWebApp.Client.Utilities

<select class="form-select" aria-label="@Label" disabled="@Disabled" @bind:get="SelectedOption" @bind:set="ChangeOption">
    <option value="">Any</option>
    <option value="@TranslationState.NeedsTranslation">Needing changes</option>
    <option value="@TranslationState.Translated">Needing verification</option>
    <option value="@TranslationState.Verified">Verified</option>
    <option value="@nameof(TranslationStringFilter.ProblemsOnly)">Strings with warnings</option>
    <option value="@nameof(TranslationStringFilter.PendingSuggestionsOnly)">Strings with pending suggestions</option>
</select>

@code {
    [Parameter]
    [EditorRequired]
    public string Label { get; set; } = string.Empty;

    [Parameter]
    public TranslationStringFilter Value { get; set; }

    [Parameter]
    public EventCallback<TranslationStringFilter> ValueChanged { get; set; }

    [Parameter]
    public bool Disabled { get; set; }

    private string? SelectedOption => Value switch
    {
        { ProblemsOnly: true } => nameof(TranslationStringFilter.ProblemsOnly),
        { PendingSuggestionsOnly: true } => nameof(TranslationStringFilter.PendingSuggestionsOnly),
        _ => Value.State?.ToString(),
    };

    private Task ChangeOption(string? option)
    {
        return ValueChanged.InvokeAsync(TranslationStringFilter.FromQuery(option,
            option == nameof(TranslationStringFilter.ProblemsOnly),
            option == nameof(TranslationStringFilter.PendingSuggestionsOnly)));
    }
}
