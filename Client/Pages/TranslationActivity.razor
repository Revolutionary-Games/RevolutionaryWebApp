@page "/translations/{Slug}/recent"
@page "/translations/{Slug}/{LanguageCode}/recent"
@using RevolutionaryWebApp.Shared
@using System.Threading
@implements IDisposable
@using RevolutionaryWebApp.Shared.Models
@inject HttpClient Http
@inject NavigationManager Navigation

<h3>Recent activity in @Slug @LanguageCode</h3>
<p>
    <NavLink href="@($"translations/{Slug}")">← Project overview</NavLink>
    @if (!string.IsNullOrEmpty(LanguageCode))
    {
        <NavLink class="ms-3" href="@($"translations/{Slug}/{LanguageCode}")">Language overview</NavLink>
    }
</p>
<div class="row mb-3">
    <fieldset class="col-12 col-md-6">
        <legend class="fs-6">Show activity</legend>
        @foreach (var type in TranslationActivityFilter.Types)
        {
            <label class="me-3" for="@($"activity-{type}")">
                <input id="@($"activity-{type}")" type="checkbox" checked="@selected.Contains(type)"
                       @onchange="@(args => ToggleType(type, args.Value is true))"/>
                @ViewLabel(type)
            </label>
        }
    </fieldset>
    <div class="col-12 col-md-6">
        @if (string.IsNullOrEmpty(LanguageCode))
        {
            <label for="activity-language">Language</label>
            <select id="activity-language" class="form-select mb-2" @bind="languageFilter" @bind:after="ApplyFilters">
                <option value="">All languages</option>
                @foreach (var language in languages)
                {
                    <option value="@language.LanguageCode">@language.DisplayName (@language.LanguageCode)</option>
                }
            </select>
        }
        <label for="activity-user">Username</label>
        <input id="activity-user" class="form-control mb-2" @bind="usernameFilter" @bind:event="oninput"
               @bind:after="TriggerUsernameDebounce"/>
        <Button Small="true" ButtonStyle="primary" Enabled="@(!loading)" OnPressed="ApplyFilters">Apply filters</Button>
    </div>
</div>
<StatusMessageShower Message="@message" Type="@messageType" OnClosed="ClearMessage"/>
@if (data != null || loading)
{
    <PaginatedTable Columns="@columns" GetSortClass="@(_ => string.Empty)" ShowPaginator="@(data != null)"
                    CurrentPage="@data?.CurrentPage"
                    PageCount="@data?.PageCount" OnPageChanged="ChangePage" ShowContentSpinner="@loading"
                    ShowNoContent="@(data?.Results.Length == 0)">
        @if (data != null)
        {
            @foreach (var item in data.Results)
            {
                <tr @key="@($"{item.Description}:{item.Id}:{item.Key}:{item.LanguageCode}")">
                    <td>
                        <RecentTimeShortener Time="@item.CreatedAt"/>
                    </td>
                    <td>
                        <NavLink href="@EditorPath(item)">
                            @item.Key
                        </NavLink>
                        <small class="d-block">@item.LanguageCode · @item.Description</small>
                        @if (item.UserId != null)
                        {
                            <UsernameDisplayer UserId="@item.UserId"/>
                        }
                    </td>
                    <td>
                        @if (item.PreviousText != null && item.PreviousText != item.Text)
                        {
                            @* TODO: we need a word-by-word diff viewer for this as most translations are a single line *@
                            <TextDiffView OldText="@item.PreviousText" NewText="@item.Text"/>
                        }
                        else
                        {
                            <pre class="text-wrap mb-0">@item.Text</pre>
                        }
                        @if (item.State != null)
                        {
                            <small>@item.PreviousState → @item.State</small>
                        }
                    </td>
                </tr>
            }
        }
    </PaginatedTable>
}

<DevCenterTitle>Recent translation activity</DevCenterTitle>

@code {

    private readonly List<TableColumn> columns =
    [
        new("When", false),
        new("String", false),
        new("Text", false),
    ];

    private CancellationTokenSource? usernameDebounce;
    private int loadVersion;
    private PagedResult<TranslationActivityDTO>? data;
    private bool loading;
    private string? message;
    private SiteNoticeType messageType = SiteNoticeType.Danger;
    private TranslationActivityView[] selected = TranslationActivityFilter.Types;
    private TranslationLanguageDTO[] languages = [];
    private string? languageFilter;
    private string? usernameFilter;

    [Parameter]
    public string Slug { get; set; } = string.Empty;

    [Parameter]
    public string LanguageCode { get; set; } = string.Empty;

    [SupplyParameterFromQuery(Name = "view")]
    public string? ViewQuery { get; set; }

    [SupplyParameterFromQuery(Name = "page")]
    public int? Page { get; set; }

    [SupplyParameterFromQuery(Name = "types")]
    public string? TypesQuery { get; set; }

    [SupplyParameterFromQuery(Name = "language")]
    public string? LanguageQuery { get; set; }

    [SupplyParameterFromQuery(Name = "username")]
    public string? UsernameQuery { get; set; }

    public override Task SetParametersAsync(ParameterView parameters)
    {
        if (!parameters.TryGetValue<string>(nameof(LanguageCode), out _))
            LanguageCode = string.Empty;
        return base.SetParametersAsync(parameters);
    }

    public void Dispose()
    {
        CancelUsernameDebounce();
        ++loadVersion;
    }

    protected override async Task OnParametersSetAsync()
    {
        CancelUsernameDebounce();
        if (!Enum.TryParse(ViewQuery ?? nameof(TranslationActivityView.All), true, out TranslationActivityView view) ||
            !TranslationActivityFilter.TryParse(TypesQuery, view, out selected))
        {
            data = null;
            message = "Invalid activity view.";
            return;
        }

        languageFilter = LanguageQuery;
        usernameFilter = UsernameQuery;
        await Load();
    }

    private static string ViewLabel(TranslationActivityView view)
    {
        return view switch
        {
            TranslationActivityView.All => "All activity",
            TranslationActivityView.Comments => "Comments",
            TranslationActivityView.Keys => "New keys",
            TranslationActivityView.Source => "Source edits",
            TranslationActivityView.Edits => "Edits",
            _ => throw new ArgumentException("Invalid activity view"),
        };
    }

    private async Task Load()
    {
        var version = ++loadVersion;
        var query = FilterQuery(Page ?? 1);
        loading = true;
        message = null;
        messageType = SiteNoticeType.Danger;
        await InvokeAsync(StateHasChanged);
        try
        {
            if (string.IsNullOrEmpty(LanguageCode))
            {
                languages = await Http.GetFromJsonAsync<TranslationLanguageDTO[]>($"api/v1/translations/" +
                    $"projects/{Uri.EscapeDataString(Slug)}/languages") ?? [];
            }

            var result = await Http.GetFromJsonAsync<PagedResult<TranslationActivityDTO>>($"api/v1/translations/" +
                $"projects/{Uri.EscapeDataString(Slug)}/recent?" +
                query);
            if (version == loadVersion)
                data = result;
        }
        catch (Exception e)
        {
            if (version == loadVersion)
            {
                data = null;
                message = "Could not load recent activity: " + e.Message;
            }
        }
        finally
        {
            if (version == loadVersion)
            {
                loading = false;
                await InvokeAsync(StateHasChanged);
            }
        }
    }

    private string FilterQuery(int page)
    {
        var language = string.IsNullOrEmpty(LanguageCode) ? languageFilter : LanguageCode;
        var types = selected.Length == 0 ? "None" : string.Join(',', selected);
        var query = $"types={Uri.EscapeDataString(types)}&page={page}";
        if (!string.IsNullOrWhiteSpace(language))
            query += "&language=" + Uri.EscapeDataString(language);
        if (!string.IsNullOrWhiteSpace(usernameFilter))
            query += "&username=" + Uri.EscapeDataString(usernameFilter.Trim());
        return query;
    }

    private Task ToggleType(TranslationActivityView type, bool enabled)
    {
        selected = enabled ? selected.Append(type).Distinct().ToArray() : selected.Where(item => item != type).ToArray();
        return ApplyFilters();
    }

    private Task ApplyFilters()
    {
        CancelUsernameDebounce();
        var path = string.IsNullOrEmpty(LanguageCode) ?
            $"translations/{Slug}/recent" :
            $"translations/{Slug}/{LanguageCode}/recent";
        var target = Navigation.ToAbsoluteUri($"{path}?{FilterQuery(1)}").AbsoluteUri;
        if (Navigation.Uri == target)
            return Load();

        Navigation.NavigateTo(target);
        return Task.CompletedTask;
    }

    private void TriggerUsernameDebounce()
    {
        CancelUsernameDebounce();
        usernameDebounce = new CancellationTokenSource();
        _ = ApplyUsernameAfterDelay(usernameDebounce.Token);
    }

    private async Task ApplyUsernameAfterDelay(CancellationToken cancellationToken)
    {
        try
        {
            await Task.Delay(1000, cancellationToken);
            await ApplyFilters();
        }
        catch (OperationCanceledException)
        {
            // A newer input, filter change, or navigation superseded this timer.
        }
    }

    private void CancelUsernameDebounce()
    {
        usernameDebounce?.Cancel();
        usernameDebounce?.Dispose();
        usernameDebounce = null;
    }

    private string EditorPath(TranslationActivityDTO item)
    {
        return $"translations/{Slug}/{item.LanguageCode}/edit?key={Uri.EscapeDataString(item.Key)}";
    }

    private void ChangePage(int page)
    {
        var path = string.IsNullOrEmpty(LanguageCode) ?
            $"translations/{Slug}/recent" :
            $"translations/{Slug}/{LanguageCode}/recent";
        Navigation.NavigateTo($"{path}?{FilterQuery(page)}");
    }

    private void ClearMessage()
    {
        message = null;
    }

}
