@page "/translations/dictionaries/{DictionaryId:long}"
@using RevolutionaryWebApp.Client.Services
@using RevolutionaryWebApp.Shared
@using RevolutionaryWebApp.Shared.Models
@using RevolutionaryWebApp.Shared.Models.Enums
@using RevolutionaryWebApp.Shared.Notifications
@using System.Threading
@inject HttpClient Http
@inject NavigationManager NavManager
@inject ComponentUrlHelper URLHelper
@inject CurrentUserInfo UserInfo
@inject NotificationHandler NotificationHandler
@implements RevolutionaryWebApp.Client.Services.INotificationHandler<TranslationDictionaryUpdated>
@implements RevolutionaryWebApp.Client.Services.INotificationHandler<TranslationDictionaryTermsUpdated>
@implements RevolutionaryWebApp.Client.Services.INotificationHandler<TranslationDictionaryTermUpdated>
@implements RevolutionaryWebApp.Client.Services.INotificationHandler<TranslationDictionaryLanguagesUpdated>
@inherits PaginatedPage<DictionaryTermDTO>

<TranslationAgreementWarning/>
<h3>Dictionary @DictionaryId</h3>

<label for="dictionary-language" class="form-label">Language</label>
<select id="dictionary-language" class="form-select mb-3" @bind="Language" @bind:after="ChangeLanguage">
    <option value="en">English</option>
    @foreach (var code in languages.Where(code => code != "en"))
    {
        <option value="@(code)">@(code)</option>
    }
</select>

@if (!string.IsNullOrEmpty(Error))
{
    <div class="alert alert-danger" role="alert">@Error</div>
}
else
{
    <PaginatedTable ShowPaginator="@(Data != null)" CurrentPage="@Data?.CurrentPage" PageCount="@Data?.PageCount"
                    OnPageChanged="async page => await ChangePage(page)"
                    OnSortChanged="async column => await ChangeSort(column)"
                    GetSortClass="@SortClass" ShowContentSpinner="@VisibleFetchInProgress"
                    Columns="@columns" ShowNoContent="@NoItemsFound">
        @if (Data != null)
        {
            @foreach (var term in Data.Results)
            {
                <tr @key="term.Id">
                    <td>
                        <DictionaryTermEditor Term="@term" LanguageCode="@Language"
                                              OnDirtyChanged="@EditorDirtyChanged"
                                              OnSavingChanged="@EditorSavingChanged"
                                              ResetVersion="@editorResetVersion"/>
                    </td>
                </tr>
            }
        }
    </PaginatedTable>
}

@if (updateWarning)
{
    <div class="alert alert-warning" role="alert">
        Dictionary data changed while you had unsaved edits. Save or copy your edits, then
        <button type="button" class="btn btn-link p-0 align-baseline" @onclick="DiscardEditsAndReload">
            discard edits and reload
        </button>
        .
    </div>
}


<hr/>

@if (Language != "en")
{
    <h4 class="mt-4">Add a @Language-specific term</h4>
    <p>Use this for a term that is useful in this language and has no regular (English) dictionary entry.</p>
    <p>
        Not all terms requested for the English dictionary are general enough to add to be useful,
        in that case this language-specific dictionary terms is a useful feature.
    </p>
    @if (CanEditTargetDictionary)
    {
        <div class="mb-2">
            <label for="local-term-word" class="form-label">Term</label>
            <input id="local-term-word" class="form-control" @bind="newLanguageWord"/>
        </div>
        <div class="mb-2">
            <label for="local-term-source-word" class="form-label">Source-language word to match</label>
            <input id="local-term-source-word" class="form-control" @bind="newLanguageSourceWord"/>
        </div>
        <div class="mb-2">
            <label for="local-term-context" class="form-label">
                Context (if needed to differentiate, leave blank otherwise)
            </label>
            <input id="local-term-context" class="form-control" @bind="newLanguageContext"/>
        </div>
        <div class="mb-2">
            <label for="local-term-explanation" class="form-label">Explanation in @Language</label>
            <textarea id="local-term-explanation" class="form-control" @bind="newLanguageExplanation"></textarea>
        </div>
        <Button ButtonStyle="outline-primary" Enabled="@(!isSubmittingLanguageTerm)"
                Spinner="@isSubmittingLanguageTerm" OnPressed="@SubmitLanguageTerm">Add @Language term
        </Button>
        <StatusMessageShower Message="@languageMessage" Type="@languageMessageType"/>
    }
    else if (UserInfo.InfoReady && !UserInfo.LoggedIn)
    {
        <p><NavLink href="@NavManager.GetLinkToLogin("Log in to add dictionary terms")">Log in</NavLink>
            to add language-specific terms.</p>
    }
}

<h4 class="mt-4">Add an English term</h4>
<p>Logged-in users can request a word. Dictionary managers can add it directly.</p>
@if (CanEditTargetDictionary)
{
    <div class="mb-2">
        <label for="new-term-word" class="form-label">Word</label>
        <input id="new-term-word" class="form-control" @bind="newWord"/>
    </div>
    <div class="mb-2">
        <label for="new-term-context" class="form-label">
            Context (if needed to differentiate the same word used to mean different things, leave blank otherwise)
        </label>
        <input id="new-term-context" class="form-control" @bind="newContext"/>
    </div>
    <div class="mb-2">
        <label for="new-term-explanation" class="form-label">English explanation</label>
        <textarea id="new-term-explanation" class="form-control" @bind="newExplanation"></textarea>
    </div>
    <Button ButtonStyle="outline-primary" Enabled="@(!isSubmittingTerm)" Spinner="@isSubmittingTerm"
            OnPressed="@SubmitTerm">
        @(CanManage ? "Add term" : "Request term")
    </Button>
    <StatusMessageShower Message="@message" Type="@messageType"/>
}
else if (UserInfo.InfoReady && !UserInfo.LoggedIn)
{
    <p><NavLink href="@NavManager.GetLinkToLogin("Log in to request dictionary terms")">Log in</NavLink>
        to request a dictionary term.</p>
}

<DevCenterTitle>Dictionary</DevCenterTitle>

@code {

    private readonly List<TableColumn> columns =
    [
        new("Term", true, nameof(DictionaryTermDTO.Word)),
    ];

    private string[] languages = [];
    private long? loadedDictionaryId;
    private string lastRequestedLanguage = "en";
    private string newWord = string.Empty;
    private string newContext = string.Empty;
    private string? newExplanation;
    private string? message;
    private SiteNoticeType messageType = SiteNoticeType.Danger;
    private string newLanguageWord = string.Empty;
    private string newLanguageSourceWord = string.Empty;
    private string newLanguageContext = string.Empty;
    private string? newLanguageExplanation;
    private string? languageMessage;
    private SiteNoticeType languageMessageType = SiteNoticeType.Danger;
    private readonly HashSet<(string Word, string Context)> dirtyEditors = [];
    private readonly HashSet<(string Word, string Context)> savingEditors = [];
    private readonly HashSet<(string Word, string Context)> pendingItemUpdates = [];
    private bool pendingTermListUpdate;
    private long? registeredDictionaryId;
    private bool updateWarning;
    private bool isSubmittingTerm;
    private bool isSubmittingLanguageTerm;
    private bool updateReceivedDuringSubmission;
    private bool dataUpdateReceivedDuringSubmission;
    private int editorResetVersion;

    [Parameter]
    public long DictionaryId { get; set; }

    [QueryStringParameter]
    public string Language { get; set; } = "en";

    private bool CanManage => UserInfo.HasGroup(GroupType.DictionaryManager) || UserInfo.IsAdmin;

    private bool CanEditTargetDictionary => UserInfo.HasAccessLevel(GroupType.User);

    public TranslationDictionary() : base(new SortHelper(nameof(DictionaryTermDTO.Word), SortDirection.Ascending))
    {
        DefaultPageSize = 100;
    }

    private bool HasUnsavedChanges => dirtyEditors.Count > 0 || !string.IsNullOrEmpty(newWord) ||
        !string.IsNullOrEmpty(newContext) || !string.IsNullOrEmpty(newExplanation) ||
        !string.IsNullOrEmpty(newLanguageWord) || !string.IsNullOrEmpty(newLanguageSourceWord) ||
        !string.IsNullOrEmpty(newLanguageContext) ||
        !string.IsNullOrEmpty(newLanguageExplanation);

    private bool HasNewTermInput => !string.IsNullOrEmpty(newWord) || !string.IsNullOrEmpty(newContext) ||
        !string.IsNullOrEmpty(newExplanation) || !string.IsNullOrEmpty(newLanguageWord) ||
        !string.IsNullOrEmpty(newLanguageSourceWord) ||
        !string.IsNullOrEmpty(newLanguageContext) || !string.IsNullOrEmpty(newLanguageExplanation);

    public override Task SetParametersAsync(ParameterView parameters)
    {
        this.SetParametersFromQueryString(NavManager);
        return base.SetParametersAsync(parameters);
    }

    protected override async Task OnInitializedAsync()
    {
        UserInfo.OnUserInfoChanged += UserInfoChanged;
        await base.OnInitializedAsync();
    }

    protected override async Task OnParametersSetAsync()
    {
        bool dictionaryChanged = loadedDictionaryId != DictionaryId;
        bool languageChanged = lastRequestedLanguage != Language;

        if (dictionaryChanged)
        {
            loadedDictionaryId = DictionaryId;
            languages = await Http.GetFromJsonAsync<string[]>($"api/v1/translationDictionaries/{DictionaryId}/languages") ?? [];
        }

        if (languageChanged)
        {
            lastRequestedLanguage = Language;
            if (Data != null)
                Page = 1;
        }

        if (Data != null && (dictionaryChanged || languageChanged))
            await FetchData();

        await UpdateNotificationRegistration();
    }

    protected override Task<PagedResult<DictionaryTermDTO>?> StartQuery(Dictionary<string, string?> requestParams)
    {
        return Http.GetFromJsonAsync<PagedResult<DictionaryTermDTO>>(QueryHelpers.AddQueryString($"api/v1/translationDictionaries/" +
            $"{DictionaryId}/terms", requestParams));
    }

    protected override Dictionary<string, string?> CreatePageRequestParams()
    {
        var result = base.CreatePageRequestParams();
        result["language"] = Language;
        return result;
    }

    protected override void PruneRequestParams(Dictionary<string, string?> queryParams)
    {
        base.PruneRequestParams(queryParams);
        if (Language == "en")
            queryParams.Remove("language");
    }

    protected override Task OnQuerySent(Dictionary<string, string?> requestParams)
    {
        return URLHelper.UpdateUrlHistoryIfChanged(requestParams);
    }

    private async Task ChangeLanguage()
    {
        lastRequestedLanguage = Language;
        Page = 1;
        await FetchData();
    }

    private Task EditorDirtyChanged((string Word, string Context, bool IsDirty) change)
    {
        if (change.IsDirty)
            dirtyEditors.Add((change.Word, change.Context));
        else
            dirtyEditors.Remove((change.Word, change.Context));

        return Task.CompletedTask;
    }

    private async Task EditorSavingChanged((string Word, string Context, bool IsSaving) change)
    {
        var key = (change.Word, change.Context);
        if (change.IsSaving)
        {
            savingEditors.Add(key);
            return;
        }

        savingEditors.Remove(key);
        if (savingEditors.Count > 0 || (!pendingTermListUpdate && pendingItemUpdates.Count == 0))
            return;

        pendingTermListUpdate = false;
        pendingItemUpdates.Clear();
        if (dirtyEditors.Count > 0)
        {
            ShowUpdateWarning();
        }
        else
        {
            await RefreshFromNotification();
        }
    }

    private async Task UpdateNotificationRegistration()
    {
        if (registeredDictionaryId == DictionaryId)
            return;

        if (registeredDictionaryId.HasValue)
            await NotificationHandler.Unregister<TranslationDictionaryUpdated>(this);

        registeredDictionaryId = DictionaryId;
        await NotificationHandler.Register<TranslationDictionaryUpdated>(this);
    }

    public Task Handle(TranslationDictionaryUpdated notification, CancellationToken cancellationToken)
    {
        if (notification.DictionaryId != DictionaryId)
            return Task.CompletedTask;

        return HandleDataUpdate();
    }

    public Task Handle(TranslationDictionaryTermsUpdated notification, CancellationToken cancellationToken)
    {
        if (notification.DictionaryId != DictionaryId)
            return Task.CompletedTask;

        if (savingEditors.Count > 0)
        {
            pendingTermListUpdate = true;
            return Task.CompletedTask;
        }

        if (isSubmittingTerm || isSubmittingLanguageTerm)
        {
            updateReceivedDuringSubmission = true;
            return Task.CompletedTask;
        }

        if (HasNewTermInput)
        {
            ShowUpdateWarning();
            return Task.CompletedTask;
        }

        return RefreshFromNotification();
    }

    public Task Handle(TranslationDictionaryTermUpdated notification, CancellationToken cancellationToken)
    {
        if (notification.DictionaryId != DictionaryId ||
            (notification.LanguageCode != "en" && notification.LanguageCode != Language) ||
            Data?.Results.Any(term => term.Word == notification.Word && term.Context == notification.Context) != true)
        {
            return Task.CompletedTask;
        }

        var key = (notification.Word, notification.Context);
        if (savingEditors.Contains(key))
        {
            pendingItemUpdates.Add(key);
            return Task.CompletedTask;
        }

        if (dirtyEditors.Contains(key))
        {
            ShowUpdateWarning();
            return Task.CompletedTask;
        }

        return RefreshFromNotification();
    }

    public Task Handle(TranslationDictionaryLanguagesUpdated notification, CancellationToken cancellationToken)
    {
        if (notification.DictionaryId != DictionaryId)
            return Task.CompletedTask;

        if (isSubmittingTerm || isSubmittingLanguageTerm)
        {
            updateReceivedDuringSubmission = true;
            return Task.CompletedTask;
        }

        return RefreshLanguagesFromNotification();
    }

    private Task HandleDataUpdate()
    {
        if (isSubmittingTerm || isSubmittingLanguageTerm)
        {
            updateReceivedDuringSubmission = true;
            dataUpdateReceivedDuringSubmission = true;
            return Task.CompletedTask;
        }

        if (HasUnsavedChanges)
        {
            ShowUpdateWarning();
            return Task.CompletedTask;
        }

        return RefreshFromNotification();
    }

    public void GetWantedListenedGroups(IUserGroupData currentUserGroups, ISet<string> groups)
    {
        groups.Add(NotificationGroups.TranslationDictionaryUpdatedPrefix + DictionaryId);
    }

    private void ShowUpdateWarning()
    {
        updateWarning = true;
        _ = InvokeAsync(StateHasChanged);
    }

    private async Task RefreshLanguagesFromNotification()
    {
        languages = await Http.GetFromJsonAsync<string[]>($"api/v1/translationDictionaries/{DictionaryId}/languages") ?? [];
        await InvokeAsync(StateHasChanged);
    }

    private async Task RefreshFromNotification()
    {
        updateWarning = false;
        languages = await Http.GetFromJsonAsync<string[]>($"api/v1/translationDictionaries/{DictionaryId}/languages") ?? [];
        await FetchData();
    }

    private async Task DiscardEditsAndReload()
    {
        newWord = string.Empty;
        newContext = string.Empty;
        newExplanation = null;
        newLanguageWord = string.Empty;
        newLanguageContext = string.Empty;
        newLanguageExplanation = null;
        dirtyEditors.Clear();
        pendingTermListUpdate = false;
        ++editorResetVersion;
        updateWarning = false;
        await RefreshFromNotification();
    }

    private async Task SubmitTerm()
    {
        if (string.IsNullOrWhiteSpace(newWord))
            return;

        var request = new CreateDictionaryTermRequest
        {
            DictionaryId = DictionaryId, Word = newWord, Context = newContext,
            Explanation = newExplanation,
        };
        var endpoint = CanManage ?
            "api/v1/translationDictionaries/terms" :
            "api/v1/translationDictionaries/requests";
        isSubmittingTerm = true;
        message = null;
        await InvokeAsync(StateHasChanged);

        try
        {
            using var response = await Http.PostAsJsonAsync(endpoint, request);
            message = response.IsSuccessStatusCode ?
                CanManage ? "Term added." : "Request sent." :
                $"Could not submit term: {await response.Content.ReadAsStringAsync()}";
            messageType = response.IsSuccessStatusCode ? SiteNoticeType.Success : SiteNoticeType.Danger;
            if (response.IsSuccessStatusCode)
            {
                newWord = string.Empty;
                newContext = string.Empty;
                newExplanation = null;
                Page = 1;
            }
        }
        catch (Exception e)
        {
            message = "Failed: " + e.Message;
            messageType = SiteNoticeType.Danger;
        }
        finally
        {
            isSubmittingTerm = false;
            await ProcessPendingUpdate();
        }

        await InvokeAsync(StateHasChanged);
    }

    private async Task SubmitLanguageTerm()
    {
        if (string.IsNullOrWhiteSpace(newLanguageWord) || string.IsNullOrWhiteSpace(newLanguageSourceWord))
            return;

        isSubmittingLanguageTerm = true;
        languageMessage = null;
        await InvokeAsync(StateHasChanged);

        try
        {
            using var response = await Http.PostAsJsonAsync("api/v1/translationDictionaries/terms/language",
                new CreateDictionaryLanguageTermRequest
                {
                    DictionaryId = DictionaryId,
                    LanguageCode = Language,
                    Word = newLanguageWord,
                    SourceWord = newLanguageSourceWord,
                    Context = newLanguageContext,
                    Explanation = newLanguageExplanation,
                });
            languageMessage = response.IsSuccessStatusCode ?
                "Language-specific term added." :
                $"Could not add term: {await response.Content.ReadAsStringAsync()}";
            languageMessageType = response.IsSuccessStatusCode ? SiteNoticeType.Success : SiteNoticeType.Danger;
            if (response.IsSuccessStatusCode)
            {
                newLanguageWord = string.Empty;
                newLanguageSourceWord = string.Empty;
                newLanguageContext = string.Empty;
                newLanguageExplanation = null;
                Page = 1;
            }
        }
        catch (Exception e)
        {
            languageMessage = "Failed: " + e.Message;
            languageMessageType = SiteNoticeType.Danger;
        }
        finally
        {
            isSubmittingLanguageTerm = false;
            await ProcessPendingUpdate();
        }

        await InvokeAsync(StateHasChanged);
    }

    private async Task ProcessPendingUpdate()
    {
        if (isSubmittingTerm || isSubmittingLanguageTerm || !updateReceivedDuringSubmission)
            return;

        updateReceivedDuringSubmission = false;
        if (HasNewTermInput || (dataUpdateReceivedDuringSubmission && dirtyEditors.Count > 0))
            ShowUpdateWarning();
        else
            await RefreshFromNotification();

        dataUpdateReceivedDuringSubmission = false;
    }

    public override async ValueTask DisposeAsync()
    {
        UserInfo.OnUserInfoChanged -= UserInfoChanged;

        if (registeredDictionaryId.HasValue)
            await NotificationHandler.Unregister<TranslationDictionaryUpdated>(this);

        await base.DisposeAsync();
    }

    private void UserInfoChanged(object? sender, UserDTO? newInfo)
    {
        _ = InvokeAsync(StateHasChanged);
    }

}
