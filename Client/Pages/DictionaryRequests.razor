@page "/translations/dictionaryRequests"
@using RevolutionaryWebApp.Shared
@using RevolutionaryWebApp.Shared.Models
@using RevolutionaryWebApp.Shared.Models.Enums
@using RevolutionaryWebApp.Shared.Notifications
@using RevolutionaryWebApp.Client.Services
@using System.Threading
@inject HttpClient Http
@inject NotificationHandler NotificationHandler
@implements INotificationHandler<TranslationDictionaryRequestsUpdated>
@implements IAsyncDisposable

<AccessLimited RequiredGroup="GroupType.DictionaryManager" OrHasOverride="GroupType.Admin"
               RedirectOnInsufficientPermission="true">
    <h3>Pending dictionary terms</h3>

    @if (requests == null)
    {
        <p>Loading requests...</p>
    }
    else if (requests.Length == 0)
    {
        <p>No requests are pending.</p>
    }
    else
    {
        @foreach (var request in requests)
        {
            <div class="border-bottom py-3">
                <strong>@request.Word</strong>
                @if (!string.IsNullOrEmpty(request.Context))
                {
                    <small>(@request.Context)</small>
                }
                <p>@request.Explanation</p>
                <small>Requested by
                    <UsernameDisplayer UserId="@request.RequesterUserId"/>
                </small>
                <div class="mt-2">
                    <Button Small="true" class="me-2" Enabled="@(!processingRequests)"
                            Spinner="@(processingRequestId == request.Id)"
                            OnPressed="@(() => Decide(request.Id, true))">Approve</Button>
                    <Button Small="true" ButtonStyle="outline-danger" Enabled="@(!processingRequests)"
                            Spinner="@(processingRequestId == request.Id)"
                            OnPressed="@(() => Decide(request.Id, false))">Reject</Button>
                </div>
            </div>
        }
    }

    <StatusMessageShower Message="@message" Type="@messageType" OnClosed="@HideMessage"/>

    <DevCenterTitle>Dictionary Requests</DevCenterTitle>
</AccessLimited>

@code {
    private DictionaryTermRequestDTO[]? requests;
    private string? message;
    private SiteNoticeType messageType = SiteNoticeType.Danger;
    private bool processingRequests;
    private long? processingRequestId;

    protected override async Task OnInitializedAsync()
    {
        await Load();
        await NotificationHandler.Register(this);
    }

    private async Task Load()
    {
        requests = await Http.GetFromJsonAsync<DictionaryTermRequestDTO[]>("api/v1/translationDictionaries/requests") ?? [];
    }

    public Task Handle(TranslationDictionaryRequestsUpdated notification, CancellationToken cancellationToken) => LoadAndRender();

    public void GetWantedListenedGroups(IUserGroupData currentUserGroups, ISet<string> groups)
    {
        groups.Add(NotificationGroups.TranslationDictionaryRequestsUpdated);
    }

    private async Task LoadAndRender()
    {
        await Load();
        await InvokeAsync(StateHasChanged);
    }

    private async Task Decide(long id, bool approve)
    {
        processingRequests = true;
        processingRequestId = id;
        await InvokeAsync(StateHasChanged);
        try
        {
            using var response = await Http.PostAsync(
                $"api/v1/translationDictionaries/requests/{id}/{(approve ? "approve" : "reject")}", null);
            message = response.IsSuccessStatusCode ? "Request handled." : "Could not handle request.";
            messageType = response.IsSuccessStatusCode ? SiteNoticeType.Success : SiteNoticeType.Danger;
        }
        finally
        {
            processingRequests = false;
            processingRequestId = null;
        }
    }

    private void HideMessage()
    {
        message = null;
    }

    public async ValueTask DisposeAsync()
    {
        await NotificationHandler.Unregister(this);
    }

}
