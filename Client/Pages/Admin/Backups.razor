@page "/admin/backup"
@inject HttpClient Http
@inject NavigationManager NavManager
@inject ComponentUrlHelper URLHelper
@inject NotificationHandler NotificationHandler
@using System.Threading
@using RevolutionaryWebApp.Client.Services
@using RevolutionaryWebApp.Shared
@using RevolutionaryWebApp.Shared.Models
@using RevolutionaryWebApp.Shared.Models.Enums
@using RevolutionaryWebApp.Shared.Notifications
@implements INotificationHandler<BackupRunStatusListUpdated>
@inherits PaginatedPage<BackupRunStatusDTO>

<AccessLimited RequiredAccess="GroupType.Admin" RedirectOnInsufficientPermission="@true">
    <h3>Backups</h3>

    <StatusMessageShower Message="@Error" Type="@SiteNoticeType.Danger"/>

    <PaginatedTable ShowPaginator="@(Data != null)" CurrentPage="@Data?.CurrentPage" PageCount="@Data?.PageCount"
                    OnPageChanged="@ChangePage"
                    OnSortChanged="@ChangeSort"
                    GetSortClass="@SortClass"
                    ShowContentSpinner="@VisibleFetchInProgress"
                    Columns="@columns"
                    ShowNoContent="@NoItemsFound"
                    UseNonFixedColumns="@true">
        @if (Data != null)
        {
            @foreach (var run in Data.Results)
            {
                <tr @key="run.Id">
                    <td><RecentTimeShortener Time="@run.FinishedAt"/></td>
                    <td>@OperationName(run.Operation)</td>
                    <td>@run.Host</td>
                    <td>
                        @if (run.ExitCode == 0)
                        {
                            <span class="text-success">Succeeded</span>
                        }
                        else
                        {
                            <span class="text-danger">Failed (exit code @run.ExitCode)</span>
                        }
                    </td>
                </tr>
            }
        }
    </PaginatedTable>

    <DevCenterTitle>Backups</DevCenterTitle>
</AccessLimited>

@code {
    private readonly List<TableColumn> columns = new()
    {
        new TableColumn("Finished", true, nameof(BackupRunStatusDTO.FinishedAt)),
        new TableColumn("Operation", false),
        new TableColumn("Reporting host", false),
        new TableColumn("Result", false),
    };

    public Backups() : base(new SortHelper(nameof(BackupRunStatusDTO.FinishedAt), SortDirection.Descending))
    {
    }

    public override Task SetParametersAsync(ParameterView parameters)
    {
        this.SetParametersFromQueryString(NavManager);
        return base.SetParametersAsync(parameters);
    }

    public Task Handle(BackupRunStatusListUpdated notification, CancellationToken cancellationToken)
    {
        return HandleItemNotification(notification);
    }

    public void GetWantedListenedGroups(IUserGroupData currentUserGroups, ISet<string> groups)
    {
        groups.Add(NotificationGroups.BackupRunStatusListUpdated);
    }

    public override async ValueTask DisposeAsync()
    {
        await base.DisposeAsync();
        await NotificationHandler.Unregister(this);
    }

    protected override async Task OnInitializedAsync()
    {
        await NotificationHandler.Register(this);
        await base.OnInitializedAsync();
    }

    protected override Task<PagedResult<BackupRunStatusDTO>?> StartQuery(Dictionary<string, string?> requestParams)
    {
        return Http.GetFromJsonAsync<PagedResult<BackupRunStatusDTO>>(
            QueryHelpers.AddQueryString("api/v1/BackupStatus", requestParams));
    }

    protected override Task OnQuerySent(Dictionary<string, string?> requestParams)
    {
        return URLHelper.UpdateUrlHistoryIfChanged(requestParams);
    }

    private static string OperationName(BackupOperation operation)
    {
        return operation switch
        {
            BackupOperation.PostgreSql => "PostgreSQL",
            BackupOperation.Bunny => "Bunny CDN",
            BackupOperation.KopiaPrimary => "Kopia primary snapshot",
            BackupOperation.KopiaSecondary => "Kopia secondary snapshot",
            _ => operation.ToString(),
        };
    }
}
