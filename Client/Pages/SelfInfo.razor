@page "/me"
@using RevolutionaryWebApp.Client.Services
@using RevolutionaryWebApp.Shared
@using RevolutionaryWebApp.Shared.Models
@using RevolutionaryWebApp.Shared.Models.Enums
@inject CurrentUserInfo CurrentUserInfo
@inject HttpClient Http
@implements IDisposable

<h3>Your Profile</h3>

<AccessLimited RequiredAccess="GroupType.User" OrHasOverride="GroupType.RestrictedUser">
    <SingleResourceDisplayer Error="@profileError" Loading="@loadingProfile" HasData="@true">
        <UserInfoPageContent User="@(profile ?? CurrentUserInfo.Info!)"/>
    </SingleResourceDisplayer>

    <br/>
    <hr/>

    <h4>Email Preferences</h4>

    <p>You can edit your email preferences on
        <NavLink href="/email-preferences">this page</NavLink>.
    </p>

    <TranslationCreditSettings />

    <hr/>
    <PasswordChangeSettings />

    <hr/>
    <TwoFactorSettings />

    <br/>
    <hr/>
    <h4>Redeem Code</h4>

    <p>If you have a special code to redeem for your Thrive account, you can redeem one here.</p>

    @if (statusMessage != null)
    {
        <div class="alert alert-info" role="alert">
            @statusMessage
        </div>
    }
    @if (errorMessage != null)
    {
        <div class="alert alert-danger" role="alert">
            @errorMessage
        </div>
    }

    <form class="login-form">
        <div class="mb-3">
            <input type="text" class="form-control" placeholder="code" @bind="codeRedeem" @bind:event="oninput">
        </div>
        <Button class="my-1" Enabled="CodeEntered" OnPressed="Submit">
            @if (processing)
            {
                <span class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></span>
            }
            Redeem
        </Button>
    </form>
</AccessLimited>

<DevCenterTitle>My Profile</DevCenterTitle>

@code {
    private UserDTO? profile;
    private bool loadingProfile;
    private string? profileError;
    private int profileRequest;

    private bool processing;
    private string? errorMessage;
    private string? statusMessage;

    private string? codeRedeem;

    private bool CodeEntered => !string.IsNullOrEmpty(codeRedeem) && codeRedeem.Length >= AppInfo.MinimumRedeemableCodeLength;

    public void Dispose()
    {
        CurrentUserInfo.OnUserInfoChanged -= OnUserInfoChanged;
        ++profileRequest;
    }

    protected override Task OnInitializedAsync()
    {
        CurrentUserInfo.OnUserInfoChanged += OnUserInfoChanged;
        return CurrentUserInfo.InfoReady ? RefreshProfile(CurrentUserInfo.Info) : Task.CompletedTask;
    }

    private async void OnUserInfoChanged(object? sender, UserDTO? user)
    {
        await InvokeAsync(async () =>
        {
            await RefreshProfile(user);
            StateHasChanged();
        });
    }

    private async Task RefreshProfile(UserDTO? user)
    {
        var request = ++profileRequest;
        profileError = null;

        if (profile?.Id != user?.Id)
            profile = null;

        loadingProfile = user != null;
        if (user == null)
            return;

        try
        {
            var latest = await Http.GetFromJsonAsync<UserDTO>($"api/v1/UserManagement/{user.Id}");
            if (request == profileRequest)
                profile = latest;
        }
        catch (Exception e)
        {
            if (request == profileRequest)
                profileError = $"Could not refresh your profile: {e.Message}";
        }
        finally
        {
            if (request == profileRequest)
                loadingProfile = false;
        }
    }

    private async void Submit()
    {
        processing = true;

        await InvokeAsync(StateHasChanged);

        HttpResponseMessage result;
        errorMessage = null;
        statusMessage = null;

        try
        {
            result = await Http.PostAsJsonAsync("api/v1/CodeRedeem", new RedeemCodeData
            {
                Code = codeRedeem!,
            });
        }
        catch (HttpRequestException e)
        {
            errorMessage = $"Network request failed: {e.Message}";
            processing = false;
            await InvokeAsync(StateHasChanged);
            return;
        }

        processing = false;
        var content = await result.Content.ReadAsStringAsync();

        if (result.IsSuccessStatusCode)
        {
            statusMessage = $"Code redeemed: {content}. If this changed your access level, you may need to " +
                "refresh to get things working.";
            codeRedeem = null;
        }
        else
        {
            errorMessage = $"Failed to redeem the code. Server responded with: {content}, {result.StatusCode}";
        }

        await InvokeAsync(StateHasChanged);
    }

}
